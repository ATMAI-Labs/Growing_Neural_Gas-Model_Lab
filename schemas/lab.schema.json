{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ATMAI-Labs/Growing_Neural_Gas-Model_Lab/raw/main/schemas/lab.schema.json",
  "title": "ATMAI GNG lab manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "id",
    "title",
    "status",
    "research_question",
    "owners",
    "created",
    "updated",
    "license",
    "references"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/non_empty_string"
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "completed",
        "archived"
      ]
    },
    "research_question": {
      "$ref": "#/$defs/non_empty_string"
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/github_handle"
      }
    },
    "created": {
      "$ref": "#/$defs/date"
    },
    "updated": {
      "$ref": "#/$defs/date"
    },
    "license": {
      "$ref": "#/$defs/non_empty_string"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "url",
          "doi"
        ],
        "properties": {
          "type": {
            "enum": [
              "paper",
              "repository",
              "dataset",
              "documentation"
            ]
          },
          "title": {
            "$ref": "#/$defs/non_empty_string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "github_handle": {
      "type": "string",
      "pattern": "^@[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  }
}
